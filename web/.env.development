# Development-only configuration. Checked in deliberately: none of it is secret,
# and the values are the same for everyone working on the tool.
#
# Points at the report service started with:
#   cd api && .venv/bin/python -m uvicorn app.main:app --port 8000
#
# Leave it unset in production builds that ship without the service — the PDF
# button then correctly does not appear. See docs/deploying.md.
VITE_API_URL=http://localhost:8000
